{
  "name": "transact-demo-ionic",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test.e2e": "cypress run",
    "test.unit": "vitest",
    "lint": "eslint",
    "build:plugin": "cd .. && npm run build",
    "sync": "npx cap sync",
    "build:ios": "npm run build && npx cap sync ios",
    "build:android": "npm run build && npx cap sync android",
    "ios": "npm run build:plugin && npm run build:ios && bash scripts/run-ios.sh",
    "android": "npm run build:plugin && npm run build:android && bash scripts/run-android.sh"
  },
  "dependencies": {
    "@atomicfi/transact-capacitor": "file:..",
    "@capacitor/android": "^8.2.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.2.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "^8.2.0",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/status-bar": "8.0.3",
    "@ionic/react": "^9.0.4",
    "@ionic/react-router": "^9.0.4",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "ionicons": "^8.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.4.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@testing-library/dom": ">=10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^16.1.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "terser": "^5.51.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "description": "An Ionic project"
}